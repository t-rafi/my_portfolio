            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            Continue with Facebook
          </button>
        </div>
        <p style="text-align:center;margin-top:1rem;"><a href="guestbook.html" style="color:#6c8bff;font-size:.8rem;">View all messages →</a></p>
      </div>
      <div id="gb-write-view" style="display:none;">
        <div id="gb-user-bar" style="display:flex;align-items:center;gap:.65rem;margin-bottom:1.25rem;"></div>
        <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1rem;font-weight:700;color:#e6edf3;margin-bottom:.75rem;">Leave a message</h3>
        <textarea id="gb-msg" maxlength="500" placeholder="Say something nice... 👋" style="width:100%;background:#08090c;border:1px solid #1e2030;border-radius:9px;padding:.75rem 1rem;color:#e6edf3;font-family:inherit;font-size:.9rem;resize:vertical;min-height:90px;outline:none;margin-bottom:.5rem;"></textarea>
        <div style="display:flex;align-items:center;justify-content:space-between;gap:.5rem;">
          <button onclick="gbSignOut()" style="background:transparent;border:1px solid #1e2030;border-radius:7px;color:#8b949e;padding:.4rem .85rem;font-family:inherit;font-size:.78rem;cursor:pointer;">Sign out</button>
          <button id="gb-send-btn" onclick="gbSend()" style="background:#6c8bff;color:#fff;border:none;border-radius:7px;padding:.5rem 1.1rem;font-family:inherit;font-size:.875rem;font-weight:600;cursor:pointer;">Send ✓</button>
        </div>
        <div id="gb-status" style="font-size:.82rem;margin-top:.6rem;min-height:1.2rem;"></div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

